{
  "name": "mwos-mobile",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File ./scripts/start-mobile-offline.ps1",
    "android": "powershell -ExecutionPolicy Bypass -File ./scripts/start-android-offline.ps1 -Offline -AvdName Pixel_9a",
    "android:offline": "powershell -ExecutionPolicy Bypass -File ./scripts/start-android-offline.ps1 -Offline -AvdName Pixel_9a",
    "android:repair": "powershell -ExecutionPolicy Bypass -File ./scripts/start-android-offline.ps1 -RepairOnly -AvdName Pixel_9a",
    "apk:debug": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-apk.ps1",
    "ios": "expo start --ios --offline",
    "web": "expo start --web --offline"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@tanstack/react-query": "^5.17.19",
    "axios": "^1.6.5",
    "date-fns": "^3.3.1",
    "expo": "~51.0.28",
    "expo-document-picker": "~12.0.2",
    "expo-local-authentication": "~14.0.1",
    "expo-notifications": "~0.28.19",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "~3.31.1",
    "react-native-svg": "15.2.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0"
  }
}

