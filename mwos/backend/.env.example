# Copy to backend/.env for local development. Never commit real credentials.
NODE_ENV=development
PORT=5000
AUTO_MIGRATE_ON_START=true

# PostgreSQL
DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=mwos_db
DB_USER=mwos_user
DB_PASSWORD=replace-with-a-strong-password

# Authentication - use unique, high-entropy values in every environment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Public web address. Multiple origins can be separated with commas.
FRONTEND_URL=http://localhost:3000

# Optional email delivery
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=MWOS <no-reply@example.com>
