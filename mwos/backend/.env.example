# Copy to backend/.env for local development. Never commit real credentials.
NODE_ENV=development
PORT=5000
AUTO_MIGRATE_ON_START=true

# PostgreSQL
# Hosted providers may instead provide a single encrypted URL, for example from Neon.
DATABASE_URL=
# Vercel and other serverless runtimes default to one connection per warm instance.
DATABASE_POOL_MAX=1
DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=mwos_db
DB_USER=mwos_user
DB_PASSWORD=replace-with-a-strong-password

# Authentication - use unique, high-entropy values in every environment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Public web address. Multiple origins can be separated with commas.
FRONTEND_URL=http://localhost:3000

# Optional social sign-in. Configure exact callback URLs with each provider.
# Keep these secrets in the backend environment only; never use a VITE_ variable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/v1/auth/facebook/callback

# Optional SMS sign-in. The gateway receives POST JSON: { "to": "...", "message": "..." }.
# Keep its URL and token in the backend environment only.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
OTP_SECRET=replace-with-a-long-random-secret

# Optional email delivery
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=MWOS <no-reply@example.com>
# Test mailboxes are never used on Vercel or in production.
EMAIL_ALLOW_TEST_TRANSPORT=false
# Enable only after real sender delivery and compatible web/Android verification screens are tested.
# When true, unavailable email fails sign-in closed; it never skips the code check.
GOOGLE_EMAIL_OTP_REQUIRED=false
